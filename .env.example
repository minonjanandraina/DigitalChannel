DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL empty to use the local SQLite fallback.
# Put development/production credentials only in the ignored .env or secret store.
# For PostgreSQL, use a URL such as:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# With no EMAIL_HOST, Django prints outgoing mail to the development console.
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@pamf.mg
EMAIL_CONFIRMATION_MAX_AGE=86400
# Development default. Leave empty in production and assign a role as Admin.
DEFAULT_SIGNUP_ROLE=Backoffice

# Optional upload destination and maximum CSV size (25 MiB by default).
MVOLA_INPUT_DIR=
MVOLA_MAX_UPLOAD_SIZE=26214400

# CBS test-environment settings. Obtain/rotate the credentials through the team.
CBS_SQLSERVER_SERVER=
CBS_SQLSERVER_DATABASE=CBS
CBS_SQLSERVER_USERNAME=
CBS_SQLSERVER_PASSWORD=
CBS_SQLSERVER_DRIVER=

